*.pbix.autosave

# VS Code
.vscode/

# Claude Code local tool-permission settings -- environment-specific, not
# part of the project itself.
.claude/

# Raw and processed data -- both are regenerated from the live Eurostat
# API (scripts/refresh_all.py does this on a schedule in CI, see
# .github/workflows/refresh.yml), so committing them would just mean
# every scheduled run produces a huge, noisy diff for files nothing reads
# from git history anyway. The built public/ output stays tracked, since
# that's what makes a fresh clone usable via file:// without first running
# the pipeline.
data/raw/
data/processed/
data/debug/

# scripts/make_share_bundle.py's output -- a disposable copy of already-
# tracked public/ files, regenerated on demand whenever a fresh folder is
# needed to zip and send to the team.
public_share/

# OS
.DS_Store
Thumbs.db